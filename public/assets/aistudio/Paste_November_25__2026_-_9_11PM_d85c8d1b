      setSelectedCountry(country);
      setIsCountryMenuOpen(false);
      const basePool =
        country === 'All Countries'
          ? DISCOVERY_PROFILES
          : ALL_DISCOVERY_PROFILES.filter((p) => p.country === country);
      const nextFiltered =
        deckFilter === 'all' ? basePool : basePool.filter((p) => p.gender === deckFilter);
      setSlideDirection(1);
      setDeckQueue(
        createNonRepeatingDeck(nextFiltered.length > 0 ? nextFiltered : basePool)
      );
    },
    [deckFilter, requireAccount]
  );

  const advanceDeck = useCallback(
    (direction: 1 | -1 = 1) => {
      setSlideDirection(direction);
      setDeckQueue((prev) => {
        if (prev.length > 1) {
          return prev.slice(1);
        }
        return createNonRepeatingDeck(filteredProfiles, prev[0]?.id);
      });
    },
    [filteredProfiles]
  );

  const handleManualPass = useCallback(() => {
    if (!requireAccount()) return;
    advanceDeck(-1);
  }, [requireAccount, advanceDeck]);

  const handleManualNext = useCallback(() => {
    if (!requireAccount()) return;
    advanceDeck(1);
  }, [requireAccount, advanceDeck]);

  // Auto-advance every 8 seconds unless paused by hover/press
  useEffect(() => {
    if (isCardPaused) return;
    const timer = window.setInterval(() => {
      advanceDeck(1);
