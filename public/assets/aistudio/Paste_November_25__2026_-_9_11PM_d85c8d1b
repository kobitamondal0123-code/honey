// Messenger State: Only populated & active after the user creates/logs into an account
const [threads, setThreads] = useState<ChatThread[]>(() =>
  userAccount ? createStarterThreads() : []
);

  const [activeChatId, setActiveChatId] = useState<string | null>(null);
  const [isChatMinimized, setIsChatMinimized] = useState(false);
  const [isInboxOpen, setIsInboxOpen] = useState(false);
  const [chatError, setChatError] = useState<string | null>(null);

  const activeChatIdRef = useRef<string | null>(null);
  const isChatMinimizedRef = useRef<boolean>(false);
  const threadsRef = useRef<ChatThread[]>(threads);
  const pendingTimeoutsRef = useRef<number[]>([]);

  useEffect(() => {
    activeChatIdRef.current = activeChatId;
    isChatMinimizedRef.current = isChatMinimized;
  }, [activeChatId, isChatMinimized]);
  useEffect(() => {
    threadsRef.current = threads;
  }, [threads]);

  // Clean up any scheduled timers on unmount
  useEffect(() => {
    return () => {
      pendingTimeoutsRef.current.forEach((id) => window.clearTimeout(id));
    };
  }, []);

  // Controlled Messenger arrivals: ONLY run while signed into an account (never before Sign Up or after Log Out)
  const isSignedIn = Boolean(userAccount);
  useEffect(() => {
    if (!isSignedIn) return;

    let timerId = 0;
    let cancelled = false;

    const scheduleNextDmArrival = () => {
      const delayMs = 60000 + Math.floor(Math.random() * 60001); // random 1 to 2 minutes
      timerId = window.setTimeout(() => {
        if (cancelled) return;

        const candidates = GLOBAL_LOUNGE_MEMBERS.filter((m) => {
          const isCurrentlyOpen =
            activeChatIdRef.current === m.memberId && !isChatMinimizedRef.current;
          const thread = threadsRef.current.find((t) => t.memberId === m.memberId);
          const lastMsg = thread?.messages[thread.messages.length - 1];
          const alreadyHasUnrepliedGreeting = Boolean(thread && lastMsg && lastMsg.sender === 'them');
          return !isCurrentlyOpen && !thread?.blockedUntilPremium && !alreadyHasUnrepliedGreeting;
        });

        if (candidates.length > 0) {
          const sender = pickRandom(candidates);
          const usedGreetings = new Set(
            threadsRef.current
              .slice(0, 8)
              .map((t) => t.messages[t.messages.length - 1]?.text)
              .filter(Boolean)
          );
          const availableGreetings = NATURAL_DM_GREETINGS.filter((g) => !usedGreetings.has(g));
          const text =
            availableGreetings.length > 0
              ? pickRandom(availableGreetings)
              : pickRandom(NATURAL_DM_GREETINGS);
          const stamp = formatNowTime();

          setThreads((prev) => {
            const existingIdx = prev.findIndex((t) => t.memberId === sender.memberId);
            const incomingMsg = {
              id: `inc-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
