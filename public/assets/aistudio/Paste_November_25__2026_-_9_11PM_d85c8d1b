    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const currentProfile = deckQueue[0] ?? filteredProfiles[0] ?? DISCOVERY_PROFILES[0];

  const handleChangeDeckFilter = useCallback(
    (nextFilter: DeckFilter) => {
      if (!requireAccount()) return;
      setDeckFilter(nextFilter);
      const basePool =
        selectedCountry === 'All Countries'
          ? DISCOVERY_PROFILES
          : ALL_DISCOVERY_PROFILES.filter((p) => p.country === selectedCountry);
      const nextFiltered =
        nextFilter === 'all' ? basePool : basePool.filter((p) => p.gender === nextFilter);
      setSlideDirection(1);
      setDeckQueue(
        createNonRepeatingDeck(nextFiltered.length > 0 ? nextFiltered : basePool)
      );
