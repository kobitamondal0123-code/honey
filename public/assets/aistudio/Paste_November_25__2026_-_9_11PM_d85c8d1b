          reason: `You have used all 5 free messages with ${targetThread.name}. Unlock Honey Chat Premium ($15 USDT / month) to message or call ${targetThread.name} again—or chat with other members!`,
        });
        return;
      }

      const outgoingId = `me-${Date.now()}`;
      const stamp = formatNowTime();

      const updatedOutgoing = {
        id: outgoingId,
        sender: 'me' as const,
        text,
        timestamp: stamp,
        seen: false,
      };
      const historySnapshot = [...targetThread.messages, updatedOutgoing].slice(-10);

      let reachedLimitNow = false;
      if (premiumStatus !== 'active') {
        const nextCount = sentToThisMember + 1;
        setFreeMessagesByMember((prev) => ({
          ...prev,
          [memberId]: nextCount,
        }));
        if (nextCount >= 5) {
          reachedLimitNow = true;
        }
      }

      setThreads((prev) =>
        prev.map((t) =>
          t.memberId === memberId
            ? {
                ...t,
                unreadCount: 0,
                blockedUntilPremium: reachedLimitNow ? true : t.blockedUntilPremium,
                messages: [...t.messages, updatedOutgoing],
              }
            : t
        )
      );

      // Random 40–60s natural human reply window: Seen at 10–22s -> Typing... -> Reply at 40–60s
      const deliverDelayMs = 40000 + Math.floor(Math.random() * 20001);
      const seenDelayMs = 10000 + Math.floor(Math.random() * 12001);
      const typingDelayMs = seenDelayMs + 2000;

      const seenTimer = window.setTimeout(() => {
        setThreads((prev) =>
          prev.map((t) =>
            t.memberId === memberId
              ? {
                  ...t,
                  messages: t.messages.map((m) =>
                    m.id === outgoingId ? { ...m, seen: true } : m
                  ),
                }
              : t
          )
        );
      }, seenDelayMs);
      pendingTimeoutsRef.current.push(seenTimer);

      if (reachedLimitNow) {
        const limitPromptTimer = window.setTimeout(() => {
          setActiveModal({
            type: 'unlock-premium',
            reason: `You have sent 5 free messages to ${targetThread.name}. Unlock Honey Chat Premium ($15 USDT / month) to keep messaging & calling ${targetThread.name}—you can still chat with other members!`,
          });
        }, 700);
        pendingTimeoutsRef.current.push(limitPromptTimer);
      }

      if (targetThread.blockedUntilPremium && premiumStatus !== 'active') {
        return;
      }

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            memberName: targetThread.name,
            memberId: targetThread.memberId,
            country: targetThread.country,
            city: targetThread.city,
            nativeLanguage: targetThread.nativeLanguage,
            bio: targetThread.bio,
            flirtyPromptLine: targetThread.flirtyPromptLine,
            userMessage: text,
            history: historySnapshot.map((m) => ({
              sender: m.sender,
              text: m.text,
            })),
          }),
        });

        const data = (await res.json()) as {
          reply?: string;
          translation?: string;
          error?: string;
        };

        if (!res.ok || !data.reply) {
          throw new Error(data.error || 'Could not reach reply service right now.');
        }

        const typingTimer = window.setTimeout(() => {
          setThreads((prev) =>
            prev.map((t) =>
              t.memberId === memberId ? { ...t, typing: true } : t
            )
          );
        }, typingDelayMs);

        const deliverTimer = window.setTimeout(() => {
          const isActiveVisible =
            activeChatIdRef.current === memberId && !isChatMinimizedRef.current;

          setThreads((prev) =>
            prev.map((t) => {
              if (t.memberId !== memberId) return t;
              return {
                ...t,
                typing: false,
                unreadCount: isActiveVisible ? 0 : t.unreadCount + 1,
                messages: [
                  ...t.messages,
                  {
                    id: `ai-${Date.now()}`,
                    sender: 'them',
                    text: data.reply!,
                    translation: data.translation || undefined,
                    timestamp: formatNowTime(),
                  },
                ],
              };
            })
          );
        }, deliverDelayMs);

        pendingTimeoutsRef.current.push(typingTimer, deliverTimer);
      } catch (err: unknown) {
        const rawErr = err instanceof Error ? err.message : '';
        const friendlyErr =
          rawErr && !rawErr.trim().startsWith('{')
            ? rawErr
            : 'Connection was briefly busy. Please send your message again.';
        setChatError(friendlyErr);
        setThreads((prev) =>
